{
  "version": 2,
  "contractVersion": "1.1.0",
  "runtimes": [
    {
      "id": "claude",
      "label": "Claude Code",
      "detect": { "command": "claude", "dir": "~/.claude" },
      "apiRuntime": "claude",
      "allowExperimental": false,
      "skillsDir": "~/.claude/skills"
    },
    {
      "id": "codex",
      "label": "Codex",
      "detect": { "command": "codex", "dir": "~/.codex" },
      "apiRuntime": "codex",
      "allowExperimental": true,
      "skillsDir": "~/.codex/skills",
      "homeEnv": "CODEX_HOME"
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "detect": { "command": "opencode", "dir": "${XDG_CONFIG_HOME:-~/.config}/opencode" },
      "apiRuntime": "opencode",
      "allowExperimental": true,
      "skillsDir": "${XDG_CONFIG_HOME:-~/.config}/opencode/allye-skills"
    },
    {
      "id": "pi",
      "label": "Pi",
      "detect": { "command": "pi", "dir": "~/.pi/agent" },
      "apiRuntime": "pi",
      "allowExperimental": false,
      "skillsDir": "~/.pi/agent/skills",
      "homeEnv": "PI_CODING_AGENT_DIR"
    },
    {
      "id": "omp",
      "label": "OMP (oh-my-pi)",
      "detect": { "command": "omp", "dir": "~/.omp/agent" },
      "apiRuntime": "pi",
      "allowExperimental": false,
      "skillsDir": "~/.omp/agent/skills"
    }
  ]
}
