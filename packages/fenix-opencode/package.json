{
  "name": "fenix-opencode",
  "version": "1.14.0",
  "description": "Fenix multi-agent plugin for OpenCode — planning, building, reviewing, and delivering with structured workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-prompts.ts",
    "build": "bun run generate && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/bun": "^1.3.10",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "fenix",
    "plugin",
    "multi-agent",
    "workflow",
    "planning",
    "tdd"
  ],
  "author": {
    "name": "Fenix Assistant",
    "email": "contact@devshire.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fenix-assistant/fenix-plugin",
    "directory": "packages/fenix-opencode"
  },
  "license": "MIT"
}
