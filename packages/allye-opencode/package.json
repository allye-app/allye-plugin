{
  "name": "allye-opencode",
  "version": "2.0.0",
  "description": "Allye plugin for OpenCode: adds the Allye bootstrap and the Bridge skill",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "prepare:assets": "bun scripts/prepare.ts",
    "build": "bun run prepare:assets && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "bun run prepare:assets && tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/bun": "^1.3.10",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "allye",
    "plugin",
    "bridge",
    "mcp",
    "skills"
  ],
  "author": {
    "name": "Allye Assistant",
    "email": "faq@devshire.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allye-app/allye-plugin",
    "directory": "packages/allye-opencode"
  },
  "license": "MIT"
}
