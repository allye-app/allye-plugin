{
  "name": "allye-pi",
  "version": "2.3.0",
  "description": "Allye extension for Pi and OMP: the Allye bootstrap, the Bridge skill and the repository-to-project link",
  "type": "module",
  "keywords": [
    "pi-package",
    "omp-plugin",
    "allye",
    "bridge",
    "mcp"
  ],
  "files": [
    "packages/allye-pi/src/index.ts",
    "packages/allye-pi/tsconfig.json",
    "skills",
    "bootstrap",
    "docs/install-pi.md",
    "docs/install-omp.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./packages/allye-pi/src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-mcp-adapter": "^2.23.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/allye-pi/tsconfig.json",
    "test:pi": "node --experimental-strip-types --test packages/allye-pi/src/index.test.ts",
    "test:installer": "bash install/test-validation.sh && bash install/test-installer.sh",
    "test:bootstrap": "bash test/test-bootstrap.sh && bash hooks/test-session-start.sh",
    "test:agents": "node test/test-agents.mjs",
    "test:skills": "node test/test-skills-text.mjs",
    "test": "npm run test:bootstrap && npm run test:agents && npm run test:skills && npm run test:installer && npm run test:pi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allye-app/allye-plugin",
    "directory": "."
  },
  "license": "MIT"
}
